// How a page is put together. Fill colour = provenance.
digraph composition {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.35, bgcolor="transparent"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#8a8a8a"];
  edge  [fontname="Helvetica", fontsize=8, color="#6b6b6b"];

  entry  [label="Entry (pages collection)\ntitle · template · content · seo", fillcolor="#ece4fb", URL="03-content-seo.html"];
  tpl    [label="Template: home / contact / default", fillcolor="#fff1c7", URL="../../resources/views/home.blade.php"];
  layout [label="layout.blade.php", fillcolor="#fff1c7", URL="../../resources/views/layout.blade.php"];
  head   [label="<s:seo:head />\ntracking · meta · JSON-LD · icons", fillcolor="#e0eefb"];
  body   [label="<s:seo:body />\nnoscript fallbacks", fillcolor="#e0eefb"];
  vite   [label="@vite: app.css + app.js\n(nonce + SRI)", fillcolor="#fde2df", URL="../../vite.config.js"];
  navbar [label="<x-navbar>\n<s:nav:main>", fillcolor="#fff1c7", URL="../../resources/views/components/navbar.blade.php"];
  footer [label="<x-footer>\n<s:nav:footer>", fillcolor="#fff1c7", URL="../../resources/views/components/footer.blade.php"];
  comps  [label="components: section · button · icon-card\ncheck-list · stat · graphics/*", fillcolor="#fff1c7", URL="../../resources/views/components"];
  js     [label="app.js: Alpine (+collapse, +intersect)\n+ window.Motion", fillcolor="#fff1c7", URL="../../resources/js/app.js"];

  entry -> tpl [label="template field"];
  tpl -> layout [label="@extends"];
  layout -> head; layout -> body; layout -> vite; layout -> navbar; layout -> footer;
  tpl -> comps;
  vite -> js;
}
