#!/usr/bin/env bash
# Downloads the newest off-site backup of a project from Backblaze B2, decrypts it and
# test-restores its database dumps. Nothing is written to B2 or to any server.
#
#   deploy/backup-verify <backup-name>          (or: dep backup:verify production)
#
# Needs: op (signed in), curl, jq, 7z, gunzip, sqlite3; docker for PostgreSQL dumps.
set -euo pipefail

name="${1:?usage: backup-verify <backup-name>}"
item='op://Personal/dig73jz7gqe6svm4llq7naj4fy'

work="$(mktemp -d)"
cleanup() {
    rm -rf "$work"
    if [[ -n "${pg_container:-}" ]]; then docker rm -f "$pg_container" >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT

auth="$(curl -fsS -u "$(op read "$item/keyID"):$(op read "$item/applicationKey")" \
    https://api.backblazeb2.com/b2api/v3/b2_authorize_account)"
token="$(jq -r .authorizationToken <<<"$auth")"
api="$(jq -r .apiInfo.storageApi.apiUrl <<<"$auth")"
download="$(jq -r .apiInfo.storageApi.downloadUrl <<<"$auth")"
bucket_id="$(jq -r .apiInfo.storageApi.bucketId <<<"$auth")"
bucket="$(jq -r .apiInfo.storageApi.bucketName <<<"$auth")"

listing="$(curl -fsS -H "Authorization: $token" "$api/b2api/v3/b2_list_file_names" \
    -d "$(jq -cn --arg b "$bucket_id" --arg p "$name/" '{bucketId: $b, prefix: $p, delimiter: "/", maxFileCount: 1000}')")"
newest="$(jq -r '[.files[] | select(.fileName | endswith(".zip"))] | sort_by(.uploadTimestamp) | last | .fileName // empty' <<<"$listing")"
count="$(jq '[.files[] | select(.fileName | endswith(".zip"))] | length' <<<"$listing")"
[[ -n "$newest" ]] || { echo "No backups found under $bucket/$name/" >&2; exit 1; }

echo "Backups under $bucket/$name/: $count. Newest: $newest"
curl -fsS -H "Authorization: $token" -o "$work/backup.zip" "$download/file/$bucket/$newest"
echo "Downloaded $(du -h "$work/backup.zip" | cut -f1)"

password="$(op read "$item/archivePassword")"
7z t -p"$password" "$work/backup.zip" >/dev/null
echo "Archive decrypts and tests OK"
7z x -y -p"$password" -o"$work/x" "$work/backup.zip" >/dev/null

echo "Top-level contents (files per entry):"
for entry in "$work/x"/* "$work/x"/.[!.]*; do
    [[ -e "$entry" ]] || continue
    printf '  %-40s %s\n' "${entry#"$work/x/"}" "$(find "$entry" -type f | wc -l)"
done

shopt -s nullglob
dumps=("$work"/x/db-dumps/*)
[[ ${#dumps[@]} -gt 0 ]] || { echo "No database dumps in the archive" >&2; exit 1; }

for dump in "${dumps[@]}"; do
    sql="$work/$(basename "${dump%.gz}")"
    if [[ "$dump" == *.gz ]]; then gunzip -c "$dump" >"$sql"; else cp "$dump" "$sql"; fi

    if grep -q -m1 'PostgreSQL database dump' "$sql"; then
        grep -q 'PostgreSQL database dump complete' "$sql" || { echo "$(basename "$sql"): dump is truncated" >&2; exit 1; }
        version="$(grep -m1 -oE 'Dumped from database version [0-9]+' "$sql" | grep -oE '[0-9]+$')"
        pg_container="backup-verify-$$"
        docker run -d --rm --name "$pg_container" -e POSTGRES_PASSWORD=verify "postgres:${version}" >/dev/null
        until docker exec "$pg_container" pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done
        sleep 2
        docker exec -i "$pg_container" psql -q -v ON_ERROR_STOP=0 -U postgres -d postgres <"$sql" >/dev/null 2>"$work/pg-errors.log" || true
        errors="$(grep -c 'ERROR' "$work/pg-errors.log" || true)"
        tables="$(docker exec "$pg_container" psql -U postgres -d postgres -tAc \
            "select count(*) from information_schema.tables where table_schema not in ('pg_catalog','information_schema')")"
        echo "$(basename "$sql"): restored into PostgreSQL ${version}, ${tables} tables, ${errors} errors"
        grep 'ERROR' "$work/pg-errors.log" | grep -v 'role .* does not exist' | head -5 || true
        docker rm -f "$pg_container" >/dev/null
        pg_container=''
    else
        sqlite3 "$work/restored.sqlite" <"$sql"
        integrity="$(sqlite3 "$work/restored.sqlite" 'pragma integrity_check')"
        tables="$(sqlite3 "$work/restored.sqlite" "select count(*) from sqlite_master where type = 'table'")"
        echo "$(basename "$sql"): restored into SQLite, ${tables} tables, integrity ${integrity}"
        [[ "$integrity" == ok ]] || exit 1
        sqlite3 "$work/restored.sqlite" "select name from sqlite_master where type = 'table' and name not like 'sqlite_%' order by name" |
            while read -r table; do printf '    %-32s %s rows\n' "$table" "$(sqlite3 "$work/restored.sqlite" "select count(*) from \"$table\"")"; done
        rm -f "$work/restored.sqlite"
    fi
done

echo "Verified $bucket/$newest"
