pixaproof.com {
  import security_headers
  root * /home/deployer/pixaproof-laravel/current/public
  file_server
  php_fastcgi * unix//run/php/php8.4-fpm.sock {
    resolve_root_symlink
  }

  log {
    output file /home/deployer/pixaproof-laravel/log/access.log {
      # No 'mode' directive: it makes Caddy chmod() the file at startup, which
      # only succeeds if Caddy OWNS it. A log file created by anything else
      # (logrotate, a deploy, an admin) then aborts the ENTIRE config load and
      # takes every vhost down. Verified against Caddy 2.11.4, 2026-07-28.
    }
  }

  handle_errors {
    @404 {
      expression {http.error.status_code} == 404
    }
    rewrite @404 /404.html
    file_server {
      root /var/deployer
    }
  }
}

pixaproof.innov8tif.com {
  redir https://pixaproof.com{uri} permanent
}
