# =============================================================================
# pixaproof — environment template (TRACKED).
# =============================================================================
# Secrets are 1Password references; `./secrets-init` resolves them into the
# gitignored .env. Non-secret config below is plain.
#
# Do not use double-brace placeholders here: `op inject` claims that syntax for
# itself and aborts on anything inside it that is not a secret reference.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Pixaproof"
APP_ENV=local
APP_KEY=op://Innov8tif/pixaproof-secrets/APP_KEY
APP_DEBUG=false
APP_URL=http://your-domain.test

# -----------------------------------------------------------------------------
# Database (SQLite)
# -----------------------------------------------------------------------------
# Path must match deploy.php sqlite_path setting
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# -----------------------------------------------------------------------------
# Cache, Session & Queue (Database)
# -----------------------------------------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Options: smtp, mailgun, postmark, ses, resend, log, array
# Production sends through Resend (MAIL_MAILER=resend), as innov8tif.com does; the
# from-address's domain must be verified in Resend.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pixaproof.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=op://Innov8tif/innov8tif-merged-laravel-secrets/RESEND_API_KEY

# Contact enquiries go to marketing with sales copied; download requests to marketing.
LEAD_MAIL_MARKETING_TO=marketing@innov8tif.com
LEAD_MAIL_SALES_CC=sales@innov8tif.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Application-Specific Variables
# -----------------------------------------------------------------------------
# Add your application's custom environment variables below.
# Examples:
#
# THIRD_PARTY_API_KEY=xxx
# STRIPE_KEY=pk_live_xxx
# STRIPE_SECRET=sk_live_xxx

# Google Tag Manager container ID (e.g. GTM-XXXXXXX), printed by the Marketing Toolkit.
# The toolkit prints tracking tags in production only. The GA4 ID lives in SEO & brand.
MT_GTM_ID=
